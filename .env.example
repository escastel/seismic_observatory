# Copy to .env and replace every CHANGE_ME_LOCALLY value. Never commit .env.
# Variable contract: specs/002-platform-data-model/contracts/runtime.md

# --- PostgreSQL --------------------------------------------------------------
# Owner of the database: creates the model, runs tests and benchmarks.
POSTGRES_DB=observatory
POSTGRES_USER=observatory
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
# Login roles created by db/sql/010_roles_schemas.sql.
# observatory_writer is used by the producer and the consumer,
# observatory_reader (read only) by the API.
DB_WRITER_PASSWORD=CHANGE_ME_LOCALLY
DB_READER_PASSWORD=CHANGE_ME_LOCALLY
DB_HOST=postgres
DB_PORT=5432

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_LIVE=earthquakes.live
KAFKA_TOPIC_CATALOG=earthquakes.catalog
KAFKA_TOPIC_REPLAY=earthquakes.replay
KAFKA_GROUP_ID=observatory-consumer
# Message retention for every topic (168 h = 7 days).
KAFKA_RETENTION_HOURS=168

# --- Producer ----------------------------------------------------------------
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
PRODUCER_INTERVAL_SECONDS=60
# Days a distinct raw feed body is kept in core.raw_payload.
RAW_PAYLOAD_RETENTION_DAYS=7

# --- Consumer ----------------------------------------------------------------
COUNTRIES_GEOJSON_PATH=/catalog/paises.geojson

# --- API ---------------------------------------------------------------------
# Exact origins allowed by CORS, comma separated. No wildcard.
CORS_ORIGINS=https://YOUR-SITE.netlify.app,http://localhost:4200

# --- Tunnel (optional, docker compose --profile tunnel) ----------------------
# Keep these only in your local .env.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
