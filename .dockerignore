.git
.gitignore
.dockerignore
.env
.env*
*.secret
*.secret.*
*.secrets
secrets/
credentials/
*credentials*.json
*credentials*.yaml
*credentials*.yml
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
coverage/
*.log
*.log*
*.pid
Dockerfile*
coverage/
specs/
tests/
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Datasets, documentation and tooling never belong in an image:
# datasets are mounted at runtime from data/ and db/seeds/.
data/
db/seeds/*.jsonl
resources/
docs/
**/*.md
.claude/
.specify/

# The test image only needs its dependency list; test code is mounted.
!tests/requirements.in
!tests/requirements.txt
